{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "mcp__codex__codex",
      "mcp__codex__review",
      "mcp__codex__websearch",
      "mcp__codex__help",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(less *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(diff *)",
      "Bash(diffstat *)",
      "Bash(comm *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(gzip *)",
      "Bash(gunzip *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(envsubst *)",
      "Bash(date *)",
      "Bash(sleep *)",
      "Bash(true *)",
      "Bash(false *)",
      "Bash(test *)",
      "Bash([ *)",
      "Bash(pbcopy *)",
      "Bash(pbpaste *)",
      "Bash(code *)",
      "Bash(open *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(go *)",
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(mongosh *)",
      "Bash(redis-cli *)",
      "Bash(ruff *)",
      "Bash(golangci-lint *)",
      "Bash(protoc *)",
      "Bash(buf *)",
      "Bash(FILE=*)",
      "Bash(LIVERPOOL_ENV=*)",
      "Bash(GOFLAGS=*)",
      "Bash(CGO_ENABLED=*)",
      "Bash(PATH=*)",
      "Bash(cd *)",
      "mcp__notion__notion-update-page",
      "mcp__notion__notion-move-pages",
      "mcp__notion__notion-query-data-sources"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"[上流から考える] 着手前に順に問う: (1) これは何のためにあるか (2) いま誰のどの判断に使われるか (3) その判断は未決か。未決でなければ手を出さない — 説明は平易な言葉を既定にし、専門用語は詳細を詰める段になってから出す。詳細: ~/.claude/docs/plain-language.md / [plan の書式] 見出しの直後に要約、その後に <details> で詳細。最初からこの形で書く（後から要約を足さない）。要約は 150 字以上・表や箇条書きや太字で見て分かる形にし、詳細を開かなくても中身が分かる水準にする。英単語をそのまま置かず日本語に言い換える（全大文字の略語とコード表記は可）。見出しに （） を使わず、修飾は ` — ` で繋ぐ。\"}}'",
            "statusMessage": "上流から考える"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが許可を求めています\" with title \"Claude Code\" subtitle \"確認待ち\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" subtitle \"処理終了\" sound name \"Hero\"'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"[チャットは平易な言葉で] ファイル（コード/doc/plan/PR/コミット）は詳細で専門的に書いてよい。チャットに書く文章は平易にする — ファイルは必要な箇所だけ読まれるが、チャットは全文が読まれるため。(1) 内部の名前（状態名/フィールド名/関数名/仕組みの名前）を単独で出さず、平易な語を先に置いて添える（例: 打ち切られた状態 `error`） (2) 数値は必ず比較対象と一緒に出す (3) 判断を求めるときは「やらない場合どうなるか」を必ず添える (4) 書いた後に読み返し、専門用語を含む文を数える。1つでもあれば言い換える。詳細: ~/.claude/docs/plain-language.md\"}}'",
            "statusMessage": "平易な言葉で説明する"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/textlint-ai-writing.sh\"",
            "timeout": 30,
            "statusMessage": "AI っぽい文章をチェック"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-format.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccusage statusline"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "mcp-apps@mcp-apps": true,
    "common-dev@awa-plugins": true,
    "github@claude-plugins-official": true,
    "infra-dev@awa-plugins": true,
    "admintool-dev@awa-plugins": true,
    "server-dev@awa-plugins": true,
    "write-postmortem@awa-plugins": true,
    "document-dev@awa-plugins": true,
    "discord@claude-plugins-official": true,
    "common@ysys": true,
    "pdm@ysys": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ysys": {
      "source": {
        "source": "github",
        "repo": "yoyogi-systems/claude-marketplace"
      }
    }
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "voiceEnabled": true,
  "model": "opus"
}
